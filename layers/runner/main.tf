terraform {
  required_version = ">= 1.3.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.95.0"
    }
  }
  # Backend + aws provider (default_tags) are generated by Terragrunt.
}

locals {
  name = "${var.project}-${var.environment}"

  tags = {
    Project     = var.project
    Environment = var.environment
    Component   = "runner"
    ManagedBy   = "terraform"
  }
}

data "aws_caller_identity" "current" {}
data "aws_partition" "current" {}

locals {
  # Auto Scaling's service-linked role; it (not the instance role) encrypts the
  # ASG instances' EBS volumes with this CMK, so the key policy must authorize it.
  autoscaling_slr_arn = "arn:${data.aws_partition.current.partition}:iam::${data.aws_caller_identity.current.account_id}:role/aws-service-role/autoscaling.amazonaws.com/AWSServiceRoleForAutoScaling"
}

# Key policy: default root/IAM delegation PLUS the Auto Scaling service-linked
# role. Without the SLR statements the ASG cannot create a grant to encrypt the
# runner's root volume and every launch is terminated with
# Client.InvalidKMSKey.InvalidState, so the ASG never reaches healthy capacity.
data "aws_iam_policy_document" "runner_kms" {
  statement {
    sid       = "EnableIAMUserPermissions"
    effect    = "Allow"
    actions   = ["kms:*"]
    resources = ["*"]
    principals {
      type        = "AWS"
      identifiers = ["arn:${data.aws_partition.current.partition}:iam::${data.aws_caller_identity.current.account_id}:root"]
    }
  }

  statement {
    sid    = "AllowAutoScalingSLRUseOfKey"
    effect = "Allow"
    actions = [
      "kms:Encrypt",
      "kms:Decrypt",
      "kms:ReEncrypt*",
      "kms:GenerateDataKey*",
      "kms:DescribeKey",
    ]
    resources = ["*"]
    principals {
      type        = "AWS"
      identifiers = [local.autoscaling_slr_arn]
    }
  }

  statement {
    sid       = "AllowAutoScalingSLRCreateGrant"
    effect    = "Allow"
    actions   = ["kms:CreateGrant"]
    resources = ["*"]
    principals {
      type        = "AWS"
      identifiers = [local.autoscaling_slr_arn]
    }
    condition {
      test     = "Bool"
      variable = "kms:GrantIsForAWSResource"
      values   = ["true"]
    }
  }
}

# Dedicated CMK for the runner's PAT secret and root volume (self-contained).
resource "aws_kms_key" "runner" {
  description             = "${local.name} CI runner encryption (PAT secret + EBS)"
  deletion_window_in_days = 30
  enable_key_rotation     = true
  policy                  = data.aws_iam_policy_document.runner_kms.json
  tags                    = local.tags
}

resource "aws_kms_alias" "runner" {
  name          = "alias/${local.name}-runner"
  target_key_id = aws_kms_key.runner.key_id
}

# ── Isolated runner VPC ──────────────────────────────────────────────────────
module "vpc" {
  source = "../../modules/runner-vpc"

  name     = local.name
  vpc_cidr = var.runner_vpc_cidr
  tags     = local.tags
}

# ── The self-hosted runner (compute + identity) ──────────────────────────────
module "runner" {
  source = "../../modules/gha-runner"

  name          = local.name
  vpc_id        = module.vpc.vpc_id
  subnet_ids    = module.vpc.private_subnet_ids
  github_owner  = var.github_owner
  github_repo   = var.github_repo
  instance_type = var.runner_instance_type

  # GitHub App used to mint runner registration tokens (private key seeded
  # out-of-band into the secret below; id/installation are not secret).
  github_app_id              = var.github_app_id
  github_app_installation_id = var.github_app_installation_id

  # Toolchain image repo lives in the bootstrap layer.
  ecr_repository_arn = var.ecr_repository_arn
  ecr_registry       = split("/", var.toolchain_repository_url)[0]

  kms_key_arn = aws_kms_key.runner.arn
  tags        = local.tags
}

# ── Peering to the application VPC (private EKS API reachability) ─────────────
module "peering" {
  source = "../../modules/runner-peering"

  name = local.name

  runner_vpc_id         = module.vpc.vpc_id
  runner_vpc_cidr       = module.vpc.vpc_cidr
  runner_route_table_id = module.vpc.private_route_table_id

  app_vpc_id          = var.app_vpc_id
  app_vpc_cidr        = var.app_vpc_cidr
  app_route_table_ids = var.app_route_table_ids

  cluster_security_group_id     = var.cluster_security_group_id
  enable_peering_dns_resolution = var.enable_peering_dns_resolution

  tags = local.tags
}
